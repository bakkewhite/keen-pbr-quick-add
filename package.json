{
  "name": "keen-pbr-quick-add-extension",
  "version": "0.4.8-beta.1",
  "description": "Quickly add or remove the active site domain in keen-pbr lists.",
  "license": "GPL-3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "npm run verify && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
    "mock-api": "node scripts/mock-api.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@react-aria/utils": "^3.34.1",
    "motion": "^14.1.0",
    "react": "19.3.0",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.14.3",
    "react-stately": "^3.51.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tldts": "7.4.10"
  },
  "overrides": {
    "figlet": "1.12.0",
    "source-map-js": "1.2.2",
    "undici": "7.29.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/chrome": "0.2.5",
    "@types/node": "22.20.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "jsdom": "29.1.1",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
