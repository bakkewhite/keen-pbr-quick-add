{
  "manifest_version": 3,
  "name": "keen-pbr Quick Add",
  "version": "0.4.8",
  "description": "Add or remove a site domain or subdomain in a keen-pbr domain list.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Add domain to keen-pbr",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/keen-pbr-16.png",
      "32": "icons/keen-pbr-32.png",
      "48": "icons/keen-pbr-48.png",
      "128": "icons/keen-pbr-128.png"
    }
  },
  "icons": {
    "16": "icons/keen-pbr-16.png",
    "32": "icons/keen-pbr-32.png",
    "48": "icons/keen-pbr-48.png",
    "128": "icons/keen-pbr-128.png"
  }
}
